    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.1",
    "@tailwindcss/vite": "4.3.2",
    "astro": "7.0.7",
    "pagefind": "1.5.2",
    "tailwindcss": "4.3.2"
  }
}
