---
import TierBadge from "../../components/TierBadge.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { allSkills, categories, fmt, fmtPercent, skillUrl, tiers } from "../../lib/catalog";
import { itemListJsonLd, truncateMeta } from "../../lib/seo";

const skillsDescription = truncateMeta(
  `Browse and sort ${allSkills.length} open Agent Skills for Claude Code, Codex, Cursor, and OpenCode. Filter by tier and category, compare context cost, and install any skill with one command.`
);
const jsonLd = itemListJsonLd(
  "Knackbox Agent Skills leaderboard",
  skillsDescription,
  allSkills.map((skill) => ({
    name: skill.name,
    path: skillUrl(skill),
    description: skill.description,
  }))
);

const columns = [
  { key: "tier", label: "Tier", width: "w-28", numeric: false },
  { key: "name", label: "Skill", width: "w-52", numeric: false },
  { key: "category", label: "Category", width: "w-28", numeric: false },
  { key: "score", label: "Skill score", width: "w-28", numeric: true },
  { key: "uplift", label: "Uplift", width: "w-24", numeric: true },
  { key: "trigger", label: "Trigger", width: "w-24", numeric: true },
  { key: "context", label: "Context", width: "w-24", numeric: true },
  { key: "updated", label: "Updated", width: "w-28", numeric: false },
];
const nullClass = "text-ink-400 dark:text-ink-500";
---

<BaseLayout
  title="Agent Skills Leaderboard"
  description={skillsDescription}
  canonicalPath="/skills/"
  keywords="agent skills leaderboard, Claude Code skills, Codex skills, Cursor skills, SKILL.md catalog, AI agent skills"
  jsonLd={jsonLd}
>
  <Fragment slot="head">
    <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  </Fragment>

  <section class="rail-section" data-pagefind-body>
    <div class="wrap py-10 sm:py-12">
    <div class="mb-6 flex flex-wrap items-end justify-between gap-x-6 gap-y-2">
      <div>
        <p class="eyebrow mb-3">01 / Quality catalog</p>
        <h1 class="section-title">Evidence leaderboard</h1>
        <p class="mt-2 max-w-3xl text-sm muted">
          Sorted by tier and quality columns — not install counts. Unmeasured scores stay
          <span class="metric">—</span> on purpose. Every skill ships a benchmark suite; see
          <a href="/why/">why this beats a popularity board</a>.
        </p>
      </div>
      <p class="text-sm muted">
        Methodology: <a href="/docs/metrics/">metrics and tiers</a>
      </p>
    </div>

    <div class="panel p-3 sm:p-4">
      <h2 class="eyebrow mb-2">Search docs &amp; skills</h2>
      <div id="pagefind-search" class="min-h-10"></div>
    </div>

    <div class="panel mt-4 p-3 sm:p-4">
      <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
        <div class="flex min-w-0 grow flex-col gap-3 sm:flex-row sm:items-center">
          <label class="sr-only" for="skill-text-filter">Quick filter for the leaderboard table</label>
          <input
            id="skill-text-filter"
            class="field sm:max-w-64"
            type="search"
            placeholder="Filter by name or description"
            autocomplete="off"
          />
          <div class="seg" role="group" aria-label="Filter by tier" data-tier-filters>
            <button type="button" data-filter-tier="all" aria-pressed="true">All</button>
            {tiers.map((tier) => (
              <button type="button" data-filter-tier={tier} aria-pressed="false">{tier}</button>
            ))}
          </div>
        </div>
        <p class="text-xs muted" aria-live="polite">
          <span class="metric font-semibold" data-visible-count>{allSkills.length}</span> of <span class="metric">{allSkills.length}</span> skills shown
        </p>
      </div>
      <div class="mt-3 flex flex-wrap items-center gap-1.5 border-t border-ink-200 pt-3 dark:border-ink-800">
        <span class="eyebrow mr-1.5">Categories</span>
        <div class="flex flex-wrap gap-1.5" role="group" aria-label="Filter by category" data-category-filters>
          {categories.map((category) => (
            <button type="button" class="chip" data-filter-category={category} aria-pressed="false">{category}</button>
          ))}
        </div>
      </div>
      <noscript>
        <p class="mt-3 border-t border-ink-200 pt-3 text-xs muted dark:border-ink-800">
          Filtering and sorting need JavaScript. The full catalog is listed below, ordered by tier.
        </p>
      </noscript>
    </div>

    <div class="mt-4 overflow-x-auto border border-ink-300 bg-ink-50 dark:border-ink-700 dark:bg-ink-950">
      <table class="w-full min-w-[960px] table-fixed text-left text-sm" data-skill-table>
        <caption class="caption-bottom border-t border-ink-200 px-3 py-2.5 text-left text-xs muted dark:border-ink-800">
          Unmeasured metrics render as <span class="metric">{fmt(null)}</span> and always sort below measured values.
        </caption>
        <thead class="border-b border-ink-300 bg-ink-200 text-[11px] uppercase text-ink-600 dark:border-ink-700 dark:bg-ink-900 dark:text-ink-300">
          <tr>
            {columns.map((column) => (
              <th
                scope="col"
                class:list={[column.width, "px-3 py-2.5"]}
                aria-sort={column.key === "tier" ? "ascending" : undefined}
              >
                <button type="button" data-sort={column.key} class:list={["sort-btn", column.numeric && "justify-end"]}>
                  <span>{column.label}</span>
                  <span class="sort-ind" aria-hidden="true"></span>
                </button>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {allSkills.map((skill) => (
            <tr
              class="border-b border-ink-100 transition-colors last:border-b-0 hover:bg-ink-50 dark:border-ink-800 dark:hover:bg-ink-800/40"
              data-category={skill.category}
              data-tier={skill.tier}
              data-name={skill.name}
              data-description={skill.description}
              data-sort-tier={skill.tier}
              data-sort-name={skill.name}
              data-sort-category={skill.category}
              data-sort-score={skill.metrics.skill_score ?? ""}
              data-sort-uplift={skill.metrics.quality_uplift ?? ""}
              data-sort-trigger={skill.metrics.trigger_accuracy ?? ""}
              data-sort-context={skill.context_tokens}
              data-sort-updated={skill.updated}
            >
              <td class="px-3 py-2.5"><TierBadge tier={skill.tier} /></td>
              <td class="px-3 py-2.5">
                <a class="break-words font-medium text-ink-950 no-underline hover:underline dark:text-white" href={skillUrl(skill)}>{skill.name}</a>
              </td>
              <td class="px-3 py-2.5 muted">{skill.category}</td>
              <td class:list={["metric px-3 py-2.5 text-right text-[13px]", skill.metrics.skill_score === null && nullClass]}>{fmt(skill.metrics.skill_score)}</td>
              <td class:list={["metric px-3 py-2.5 text-right text-[13px]", skill.metrics.quality_uplift === null && nullClass]}>{fmtPercent(skill.metrics.quality_uplift)}</td>
              <td class:list={["metric px-3 py-2.5 text-right text-[13px]", skill.metrics.trigger_accuracy === null && nullClass]}>{fmtPercent(skill.metrics.trigger_accuracy)}</td>
              <td class="metric px-3 py-2.5 text-right text-[13px]">{skill.context_tokens}</td>
              <td class="metric px-3 py-2.5 text-[13px]">{skill.updated}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    </div>
  </section>

  <script src="/pagefind/pagefind-ui.js" is:inline></script>
  <script is:inline>
    (() => {
      const tierRanks = { core: 0, verified: 1, community: 2 };
      const table = document.querySelector("[data-skill-table]");
      const tbody = table?.querySelector("tbody");
      if (!table || !tbody) return;

      const rows = Array.from(tbody.querySelectorAll("tr"));
      const state = {
        sortKey: "tier",
        direction: "asc",
        categories: new Set(),
        tier: "all",
        query: "",
      };

      const numberKeys = new Set(["score", "uplift", "trigger", "context"]);

      function valueFor(row, key) {
        const value = row.dataset[`sort${key[0].toUpperCase()}${key.slice(1)}`] ?? "";
        if (key === "tier") return tierRanks[value] ?? 99;
        if (numberKeys.has(key)) return value === "" ? null : Number(value);
        return value;
      }

      function compareRows(a, b) {
        const av = valueFor(a, state.sortKey);
        const bv = valueFor(b, state.sortKey);
        const aNull = av === null || av === "";
        const bNull = bv === null || bv === "";
        if (aNull && !bNull) return 1;
        if (!aNull && bNull) return -1;
        if (aNull && bNull) return a.dataset.name.localeCompare(b.dataset.name);

        let result = 0;
        if (typeof av === "number" && typeof bv === "number") {
          result = av - bv;
        } else {
          result = String(av).localeCompare(String(bv));
        }
        if (result === 0) {
          result = a.dataset.name.localeCompare(b.dataset.name);
        }
        return state.direction === "asc" ? result : -result;
      }

      function syncSortHeaders() {
        table.querySelectorAll("thead th").forEach((th) => {
          const button = th.querySelector("[data-sort]");
          if (!button) return;
          if (button.dataset.sort === state.sortKey) {
            th.setAttribute("aria-sort", state.direction === "asc" ? "ascending" : "descending");
          } else {
            th.removeAttribute("aria-sort");
          }
        });
      }

      function applyState() {
        syncSortHeaders();
        const query = state.query.trim().toLowerCase();
        const sorted = [...rows].sort(compareRows);
        let visible = 0;
        for (const row of sorted) {
          const matchesCategory =
            state.categories.size === 0 || state.categories.has(row.dataset.category);
          const matchesTier = state.tier === "all" || row.dataset.tier === state.tier;
          const haystack = `${row.dataset.name} ${row.dataset.category} ${row.dataset.description}`.toLowerCase();
          const matchesQuery = !query || haystack.includes(query);
          const show = matchesCategory && matchesTier && matchesQuery;
          row.hidden = !show;
          if (show) visible += 1;
          tbody.appendChild(row);
        }
        const visibleCount = document.querySelector("[data-visible-count]");
        if (visibleCount) visibleCount.textContent = String(visible);
      }

      document.querySelectorAll("[data-sort]").forEach((button) => {
        button.addEventListener("click", () => {
          const key = button.dataset.sort;
          if (state.sortKey === key) {
            state.direction = state.direction === "asc" ? "desc" : "asc";
          } else {
            state.sortKey = key;
            state.direction = numberKeys.has(key) ? "desc" : "asc";
          }
          applyState();
        });
      });

      document.querySelectorAll("[data-filter-category]").forEach((button) => {
        button.addEventListener("click", () => {
          const category = button.dataset.filterCategory;
          if (state.categories.has(category)) {
            state.categories.delete(category);
            button.setAttribute("aria-pressed", "false");
          } else {
            state.categories.add(category);
            button.setAttribute("aria-pressed", "true");
          }
          applyState();
        });
      });

      document.querySelectorAll("[data-filter-tier]").forEach((button) => {
        button.addEventListener("click", () => {
          state.tier = button.dataset.filterTier;
          document.querySelectorAll("[data-filter-tier]").forEach((tierButton) => {
            tierButton.setAttribute("aria-pressed", String(tierButton === button));
          });
          applyState();
        });
      });

      const quickFilter = document.querySelector("#skill-text-filter");
      quickFilter?.addEventListener("input", () => {
        state.query = quickFilter.value;
        applyState();
      });

      function initPagefind() {
        if (!window.PagefindUI) return false;
        new window.PagefindUI({
          element: "#pagefind-search",
          showSubResults: true,
          resetStyles: false,
        });
        return true;
      }

      window.addEventListener("load", () => {
        if (initPagefind()) return;
        const search = document.querySelector("#pagefind-search");
        if (search && !search.children.length) {
          search.innerHTML =
            '<p class="text-sm muted">Pagefind search is generated during production builds.</p>';
        }
      });

      applyState();
    })();
  </script>
</BaseLayout>
