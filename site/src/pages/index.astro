---
import CopyButton from "../components/CopyButton.astro";
import SkillRow from "../components/SkillRow.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  allSkills,
  byTier,
  categories,
  catalog,
  githubRepoUrl,
  knackboxCliCommand,
  skillUrl,
  tierCounts,
} from "../lib/catalog";
import {
  catalogStatsLine,
  defaultDescription,
  defaultTitle,
  itemListJsonLd,
  softwareSourceJsonLd,
  websiteJsonLd,
} from "../lib/seo";

const counts = tierCounts();
const coreSkills = byTier("core");
const command = `${knackboxCliCommand} commit-messages`;
const stats = [
  { label: "Skills", value: allSkills.length, wide: true },
  { label: "Categories", value: categories.length },
  { label: "Core", value: counts.core },
  { label: "Verified", value: counts.verified },
  { label: "Community", value: counts.community },
];
const jsonLd = [
  websiteJsonLd(),
  softwareSourceJsonLd(),
  itemListJsonLd(
    "Knackbox core Agent Skills",
    "Maintainer-curated core skills in the Knackbox catalog.",
    coreSkills.map((skill) => ({
      name: skill.name,
      path: skillUrl(skill),
      description: skill.description,
    }))
  ),
];
---

<BaseLayout title={defaultTitle} description={defaultDescription} canonicalPath="/" jsonLd={jsonLd}>
  <section class="rail-section" data-pagefind-body>
    <div class="wrap py-14 sm:py-16 lg:py-20">
      <a class="eyebrow inline-flex no-underline hover:no-underline" href="/skills/">
        catalog v0 / {catalogStatsLine()}
      </a>
      <h1 class="hero-title mt-8">The open skill library for AI agents.</h1>
      <p class="mt-5 max-w-2xl text-[16px] leading-7 muted">
        Plain-file <strong class="font-semibold text-ink-900 dark:text-ink-100">Agent Skills</strong> that
        Claude Code, Codex, Cursor, and OpenCode load when a task matches. Browse the open catalog,
        inspect every <code class="font-mono text-[13px]">SKILL.md</code>, and install only what you need.
      </p>
      <div class="mt-7 flex flex-wrap gap-2.5">
        <a class="btn btn-primary no-underline hover:no-underline" href="/skills/">Browse catalog</a>
        <a class="btn no-underline hover:no-underline" href="/packs/">Starter packs</a>
        <a class="btn no-underline hover:no-underline" href={githubRepoUrl}>View source</a>
      </div>

      <div class="hero-command">
        <div class="hero-command-head">
          <h2 class="eyebrow">Install / bash</h2>
          <CopyButton value={command} />
        </div>
        <pre class="terminal border-0"><code>{command}</code></pre>
        <p class="border-t border-ink-300 px-4 py-3 text-xs muted dark:border-ink-700">
          Knackbox CLI installs into <code class="font-mono">~/.claude/skills</code> by default.
          Pass <code class="font-mono">--agent cursor</code> (or codex / opencode) for other roots.
          See <a href="/docs/">installation docs</a> for the ecosystem Skills CLI and curl fallback.
        </p>
      </div>
    </div>
  </section>

  <section class="rail-section" aria-label="Catalog statistics">
    <div class="wrap px-0">
      <dl class="figure-grid">
        {stats.map((stat) => (
          <div class:list={["figure", stat.wide && "col-span-2 sm:col-span-1"]}>
            <dt class="eyebrow">{stat.label}</dt>
            <dd class="metric mt-4 text-[30px] font-bold leading-none text-ink-950 dark:text-ink-50">{stat.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="rail-section">
    <div class="wrap py-12 sm:py-14">
      <div class="mb-6 flex flex-wrap items-end justify-between gap-x-6 gap-y-3">
        <div>
          <p class="eyebrow mb-3">Curated set</p>
          <h2 class="section-title">Core skills</h2>
          <p class="mt-2 text-sm muted">Maintainer-curated skills surfaced first in the catalog.</p>
        </div>
        <a class="text-sm font-semibold" href="/docs/metrics/">Tier methodology</a>
      </div>
      <ul class="panel list-none divide-y divide-ink-300 dark:divide-ink-800">
        {coreSkills.map((skill) => <SkillRow skill={skill} />)}
      </ul>
      <p class="mt-4 text-xs muted">
        Catalog generated <span class="metric">{catalog.generated}</span>. Scores follow version <span class="metric">{catalog.score_version}</span>.
        Unmeasured metrics stay <span class="metric">—</span> until the benchmark harness runs.
      </p>
    </div>
  </section>

  <section class="rail-section" aria-label="Skill categories">
    <div class="wrap py-12 sm:py-14">
      <p class="eyebrow mb-3">Browse by category</p>
      <h2 class="section-title">Agent skill categories</h2>
      <p class="mt-2 max-w-2xl text-sm muted">
        Coding, data, documents, productivity, research, and writing — each skill is a portable folder with
        triggers, instructions, and a benchmark suite.
      </p>
      <ul class="mt-6 grid list-none gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {categories.map((category) => {
          const count = allSkills.filter((skill) => skill.category === category).length;
          return (
            <li>
              <a class="panel block p-4 no-underline hover:no-underline" href={`/skills/${category}/`}>
                <span class="text-base font-semibold text-ink-950 dark:text-ink-50">{category}</span>
                <span class="mt-1 block text-sm muted">{count} skills</span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>
</BaseLayout>
