---
import CopyButton from "../components/CopyButton.astro";
import TierBadge from "../components/TierBadge.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { allSkills, packs, skillUrl } from "../lib/catalog";
import { itemListJsonLd, truncateMeta } from "../lib/seo";

const entries = packs.map((pack) => ({
  ...pack,
  command: `npx knackbox pack ${pack.slug}`,
  skillEntries: pack.skills.map((name) => allSkills.find((skill) => skill.name === name)).filter(Boolean),
}));
const packsDescription = truncateMeta(
  "Install curated Agent Skills starter packs for developers, data work, research, writing, and project leadership. One command installs a coherent multi-skill workflow for Claude Code, Codex, and Cursor."
);
const jsonLd = itemListJsonLd(
  "Knackbox starter packs",
  packsDescription,
  entries.map((pack) => ({
    name: pack.name,
    path: `/packs/#${pack.slug}`,
    description: pack.description,
  }))
);
---

<BaseLayout
  title="Agent Skills Starter Packs"
  description={packsDescription}
  canonicalPath="/packs/"
  keywords="agent skills packs, Claude Code skill packs, developer essentials skills, AI agent workflow packs"
  jsonLd={jsonLd}
>
  <section class="rail-section" data-pagefind-body>
    <div class="wrap py-10 sm:py-12">
      <p class="eyebrow mb-3">02 / Starter packs</p>
      <h1 class="section-title">Install a coherent Agent Skills workflow</h1>
      <p class="mt-3 max-w-3xl leading-7 muted">
        Packs group complementary open skills for a job — coding, data, research, writing, and leadership.
        Install a whole pack with <code class="font-mono text-[13px]">npx knackbox pack &lt;slug&gt;</code>,
        or install individual skills from the list below.
      </p>
    </div>
  </section>

  {entries.map((pack, index) => (
    <section class="rail-section" id={pack.slug}>
      <div class="wrap py-10 sm:py-12">
        <div class="mb-6 max-w-3xl">
          <p class="eyebrow mb-3">Pack {String(index + 1).padStart(2, "0")}</p>
          <h2 class="section-title">{pack.name}</h2>
          <p class="mt-2 leading-7 muted">{pack.description}</p>
        </div>

        <div class="hero-command mt-0 max-w-none">
          <div class="hero-command-head">
            <h3 class="eyebrow">Install / {pack.skills.length} skills</h3>
            <CopyButton value={pack.command} />
          </div>
          <pre class="terminal border-0"><code>{pack.command}</code></pre>
        </div>

        <ul class="panel mt-5 list-none divide-y divide-ink-300 dark:divide-ink-800">
          {pack.skillEntries.map((skill) => skill && (
            <li class="flex flex-wrap items-center justify-between gap-3 px-4 py-3">
              <div class="min-w-0">
                <a class="font-semibold no-underline hover:underline" href={skillUrl(skill)}>{skill.name}</a>
                <span class="ml-2"><TierBadge tier={skill.tier} /></span>
              </div>
              <span class="text-xs muted">{skill.category}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}
</BaseLayout>
