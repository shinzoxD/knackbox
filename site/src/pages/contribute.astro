---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getRepoMarkdownHtml, githubRepoUrl } from "../lib/catalog";

const html = getRepoMarkdownHtml("CONTRIBUTING.md");
---

<BaseLayout title="Contribute | Knackbox" description="Contribute skills to Knackbox">
  <section class="border-b border-ink-200 bg-white dark:border-ink-800 dark:bg-ink-900">
    <div class="wrap py-10">
      <h1 class="text-3xl font-semibold tracking-normal text-ink-950 dark:text-white">Contribute</h1>
      <p class="mt-3 max-w-3xl muted">Add a skill, improve benchmarks, or request a missing workflow.</p>
      <div class="mt-6">
        <a class="btn btn-primary no-underline" href={`${githubRepoUrl}/issues?q=is%3Aissue+is%3Aopen+label%3Askill-request`}>Skill requests</a>
      </div>
    </div>
  </section>
  <section class="wrap py-10">
    <article class="prose-skill" data-pagefind-body set:html={html} />
  </section>
</BaseLayout>
