---
import CopyButton from "../../components/CopyButton.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  installCommand,
  knackboxCliCommand,
  legacyInstallCommand,
} from "../../lib/catalog";

const knackboxExample = `${knackboxCliCommand} commit-messages`;
const knackboxPackExample = "npx knackbox pack developer-essentials";
const skillsExample = `${installCommand} commit-messages`;
const legacyExample = `${legacyInstallCommand} commit-messages`;
---

<BaseLayout
  title="Install Agent Skills — Docs"
  description="How to install Knackbox Agent Skills with the knackbox CLI, Skills CLI, curl installer, Claude.ai, and any SKILL.md-compatible runtime."
  canonicalPath="/docs/"
  keywords="install agent skills, npx knackbox add, Claude Code skills install, npx skills add, SKILL.md install"
>
  <section class="rail-section" data-pagefind-body>
    <div class="wrap py-10 sm:py-12">
    <div class="mb-8 border-b border-ink-200 pb-6 dark:border-ink-800">
      <p class="eyebrow mb-3">02 / Documentation</p>
      <h1 class="section-title">Install Agent Skills</h1>
      <p class="mt-2 max-w-3xl text-sm leading-6 muted">
        Skills are folders with a <code class="font-mono text-[13px]">SKILL.md</code> file and optional
        resources that an AI agent loads for a specific job. Knackbox skills follow the open Agent Skills format.
      </p>
    </div>

    <h2 class="eyebrow mb-3">Install targets</h2>
    <div class="grid gap-4 lg:grid-cols-2">
      <section class="panel p-4 sm:p-5">
        <h3 class="text-base font-semibold text-ink-950 dark:text-white">Knackbox CLI</h3>
        <p class="mt-2 text-sm leading-6 muted">
          Zero-dependency Node CLI. Resolves the live catalog, downloads the repo tarball, and extracts only the
          skill folder. Defaults to <code class="font-mono text-[13px]">~/.claude/skills</code>.
        </p>
        <p class="mt-2 text-sm leading-6 muted">
          Use <code class="font-mono text-[13px]">--agent cursor|codex|opencode</code>,
          {" "}<code class="font-mono text-[13px]">--dest DIR</code>, or
          {" "}<code class="font-mono text-[13px]">--force</code>. Install a starter pack with
          {" "}<code class="font-mono text-[13px]">npx knackbox pack &lt;slug&gt;</code>.
        </p>
        <div class="mt-4 flex items-center justify-between gap-3">
          <h4 class="text-sm font-semibold">Add a skill</h4>
          <CopyButton value={knackboxExample} />
        </div>
        <pre class="terminal mt-2"><code>{knackboxExample}</code></pre>
        <div class="mt-4 flex items-center justify-between gap-3">
          <h4 class="text-sm font-semibold">Install a pack</h4>
          <CopyButton value={knackboxPackExample} />
        </div>
        <pre class="terminal mt-2"><code>{knackboxPackExample}</code></pre>
      </section>

      <section class="panel p-4 sm:p-5">
        <h3 class="text-base font-semibold text-ink-950 dark:text-white">Skills CLI</h3>
        <p class="mt-2 text-sm leading-6 muted">
          Install through the open Agent Skills ecosystem. The CLI detects installed agents including Claude Code,
          Codex, OpenCode, Cursor, and others.
        </p>
        <p class="mt-2 text-sm leading-6 muted">
          Add <code class="font-mono text-[13px]">-g</code> for a global install or
          {" "}<code class="font-mono text-[13px]">-a claude-code</code> to select a target explicitly.
        </p>
        <div class="mt-4 flex items-center justify-between gap-3">
          <h4 class="text-sm font-semibold">Example</h4>
          <CopyButton value={skillsExample} />
        </div>
        <pre class="terminal mt-2"><code>{skillsExample}</code></pre>
      </section>

      <section class="panel p-4 sm:p-5">
        <h3 class="text-base font-semibold text-ink-950 dark:text-white">Claude.ai</h3>
        <p class="mt-2 text-sm leading-6 muted">
          Open Settings, Capabilities, Skills, then upload the skill folder or paste
          the <code class="font-mono text-[13px]">SKILL.md</code> content.
        </p>
      </section>

      <section class="panel p-4 sm:p-5">
        <h3 class="text-base font-semibold text-ink-950 dark:text-white">Repository installer</h3>
        <p class="mt-2 text-sm leading-6 muted">
          The dependency-free shell installer remains available for Claude Code or a custom destination.
        </p>
        <div class="mt-4 flex items-center justify-between gap-3">
          <h4 class="text-sm font-semibold">Fallback</h4>
          <CopyButton value={legacyExample} />
        </div>
        <pre class="terminal mt-2"><code>{legacyExample}</code></pre>
      </section>
    </div>

    <section class="mt-10 max-w-3xl">
      <h2 class="section-title">Skill format</h2>
      <p class="mt-3 leading-7 muted">
        Each skill has YAML frontmatter with a <code class="font-mono text-[13px]">name</code> and a
        trigger-oriented <code class="font-mono text-[13px]">description</code>, followed by instructions.
        Optional <code class="font-mono text-[13px]">references/</code>, <code class="font-mono text-[13px]">scripts/</code>,
        and <code class="font-mono text-[13px]">assets/</code> folders stay with the skill.
      </p>
      <p class="mt-3 leading-7 muted">
        Scores, tiers, and catalog fields are generated from the repository.
        See <a href="/docs/metrics/">metrics</a> for the measurement model.
      </p>
    </section>
    </div>
  </section>
</BaseLayout>
