---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getRepoMarkdownHtml } from "../../lib/catalog";

const html = getRepoMarkdownHtml("METRICS.md");
---

<BaseLayout
  title="Agent Skills Metrics & Tiers"
  description="How Knackbox measures Agent Skills: trigger accuracy, quality uplift, context cost, efficiency, and tier promotion from community to verified to core."
  canonicalPath="/docs/metrics/"
  keywords="agent skills metrics, skill score, trigger accuracy, quality uplift, knackbox tiers"
>
  <section class="rail-section">
    <div class="wrap py-10 sm:py-12">
      <p class="eyebrow mb-6">03 / Measurement</p>
      <article class="prose-skill max-w-3xl" data-pagefind-body set:html={html} />
    </div>
  </section>
</BaseLayout>

