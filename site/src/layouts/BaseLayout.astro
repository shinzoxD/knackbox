---
import "../styles/global.css";
import { githubRepoUrl } from "../lib/catalog";

const {
  title = "Knackbox",
  description = "An open library of skills for AI agents",
} = Astro.props as { title?: string; description?: string };

const path = Astro.url.pathname;
const nav = [
  { href: "/skills/", label: "Skills" },
  { href: "/packs/", label: "Packs" },
  { href: "/docs/", label: "Docs" },
  { href: "/contribute/", label: "Contribute", mobileHidden: true },
];
const isActive = (href: string) => path === href || path.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const saved = localStorage.getItem("theme");
        const dark =
          saved === "dark" ||
          (!saved && window.matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.classList.toggle("dark", dark);
      })();
    </script>
    <slot name="head" />
  </head>
  <body class="min-h-screen">
    <a href="#main" class="skip-link">Skip to content</a>
    <header class="rail-section bg-ink-50 dark:bg-[#080707]">
      <div class="wrap flex h-20 items-center justify-between gap-3">
        <a href="/" class="brand-wordmark min-w-0" aria-label="Knackbox home">
          <span class="brand-glyph" aria-hidden="true">kb</span>
          <span class="hidden sm:inline">knackbox</span>
        </a>
        <nav class="flex items-center gap-0.5 sm:gap-2" aria-label="Main">
          {nav.map((item) => (
            <a class:list={["nav-link", item.mobileHidden && "hidden sm:inline-flex"]} href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a>
          ))}
          <a class="nav-link hidden md:inline-flex" href={githubRepoUrl}>GitHub</a>
          <button type="button" class="btn btn-icon ml-1 h-9 w-9" data-theme-toggle aria-label="Toggle color theme" title="Toggle color theme">
            <span aria-hidden="true">◐</span>
          </button>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="rail-section border-t border-ink-300 dark:border-ink-800">
      <div class="wrap flex flex-col gap-4 py-8 text-[12px] sm:flex-row sm:items-center sm:justify-between">
        <p class="muted">[ Apache-2.0 ] Static catalog generated from repository skills.</p>
        <nav class="flex flex-wrap gap-x-4 gap-y-2" aria-label="Footer">
          <a href="/skills/">Leaderboard</a>
          <a href="/packs/">Starter packs</a>
          <a href="/docs/metrics/">Metrics</a>
          <a href="/contribute/">Contribute</a>
          <a href={githubRepoUrl}>GitHub</a>
        </nav>
      </div>
    </footer>
    <script is:inline>
      document.addEventListener("click", async (event) => {
        const copyButton = event.target.closest("[data-copy]");
        if (copyButton) {
          const original = copyButton.textContent;
          try {
            await navigator.clipboard.writeText(copyButton.dataset.copy);
            copyButton.textContent = "Copied";
            copyButton.classList.add("copy-done");
          } catch {
            copyButton.textContent = "Copy failed";
          }
          window.setTimeout(() => {
            copyButton.textContent = original;
            copyButton.classList.remove("copy-done");
          }, 1200);
        }

        const themeButton = event.target.closest("[data-theme-toggle]");
        if (themeButton) {
          const nextDark = !document.documentElement.classList.contains("dark");
          document.documentElement.classList.toggle("dark", nextDark);
          localStorage.setItem("theme", nextDark ? "dark" : "light");
        }
      });
    </script>
  </body>
</html>
