---
import "../styles/global.css";
import { githubRepoUrl } from "../lib/catalog";
import {
  absoluteUrl,
  defaultDescription,
  defaultKeywords,
  defaultTitle,
  siteUrl,
  truncateMeta,
  withSiteTitle,
} from "../lib/seo";

type Props = {
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogType?: "website" | "article";
  noindex?: boolean;
  keywords?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  updated?: string;
};

const {
  title = defaultTitle,
  description = defaultDescription,
  canonicalPath,
  ogType = "website",
  noindex = false,
  keywords = defaultKeywords,
  jsonLd,
  updated,
} = Astro.props as Props;

const pageTitle = withSiteTitle(title);
const metaDescription = truncateMeta(description);
const path = Astro.url.pathname;
const canonical = absoluteUrl(canonicalPath ?? path);
const ogImage = absoluteUrl("/og.svg");
const robots = noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large";
const jsonLdBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

const nav = [
  { href: "/skills/", label: "Skills" },
  { href: "/packs/", label: "Packs" },
  { href: "/docs/", label: "Docs" },
  { href: "/contribute/", label: "Contribute", mobileHidden: true },
];
const isActive = (href: string) => path === href || path.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Knackbox" />
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={robots} />
    <meta name="theme-color" content="#0c0b0a" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f6f3ee" media="(prefers-color-scheme: light)" />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/json" title="Knackbox skills catalog" href={absoluteUrl("/catalog.json")} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://github.com" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Knackbox" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/svg+xml" />
    <meta property="og:image:alt" content="Knackbox — open library of skills for AI agents" />
    {updated && <meta property="article:modified_time" content={updated} />}

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Knackbox — open library of skills for AI agents" />

    <meta name="application-name" content="Knackbox" />
    <meta name="generator" content={Astro.generator} />
    <link rel="me" href={githubRepoUrl} />

    {jsonLdBlocks.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}

    <script is:inline>
      (() => {
        const saved = localStorage.getItem("theme");
        const dark =
          saved === "dark" ||
          (!saved && window.matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.classList.toggle("dark", dark);
      })();
    </script>
    <slot name="head" />
  </head>
  <body class="min-h-screen">
    <a href="#main" class="skip-link">Skip to content</a>
    <header class="rail-section bg-ink-50 dark:bg-[#080707]">
      <div class="wrap flex h-20 items-center justify-between gap-3">
        <a href="/" class="brand-wordmark min-w-0" aria-label="Knackbox home">
          <span class="brand-glyph" aria-hidden="true">kb</span>
          <span class="hidden sm:inline">knackbox</span>
        </a>
        <nav class="flex items-center gap-0.5 sm:gap-2" aria-label="Main">
          {nav.map((item) => (
            <a class:list={["nav-link", item.mobileHidden && "hidden sm:inline-flex"]} href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a>
          ))}
          <a class="nav-link hidden md:inline-flex" href={githubRepoUrl}>GitHub</a>
          <button type="button" class="btn btn-icon ml-1 h-9 w-9" data-theme-toggle aria-label="Toggle color theme" title="Toggle color theme">
            <span aria-hidden="true">◐</span>
          </button>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="rail-section border-t border-ink-300 dark:border-ink-800">
      <div class="wrap flex flex-col gap-4 py-8 text-[12px] sm:flex-row sm:items-center sm:justify-between">
        <div class="space-y-1">
          <p class="muted">[ Apache-2.0 ] Static catalog generated from repository skills.</p>
          <p class="muted">
            Open Agent Skills for Claude Code, Codex, Cursor, and compatible tools ·{" "}
            <a href={siteUrl}>{siteUrl.replace(/^https:\/\//, "")}</a>
          </p>
        </div>
        <nav class="flex flex-wrap gap-x-4 gap-y-2" aria-label="Footer">
          <a href="/skills/">Leaderboard</a>
          <a href="/packs/">Starter packs</a>
          <a href="/docs/">Install docs</a>
          <a href="/docs/metrics/">Metrics</a>
          <a href="/contribute/">Contribute</a>
          <a href="/llms.txt">llms.txt</a>
          <a href={githubRepoUrl}>GitHub</a>
        </nav>
      </div>
    </footer>
    <script is:inline>
      document.addEventListener("click", async (event) => {
        const copyButton = event.target.closest("[data-copy]");
        if (copyButton) {
          const original = copyButton.textContent;
          try {
            await navigator.clipboard.writeText(copyButton.dataset.copy);
            copyButton.textContent = "Copied";
            copyButton.classList.add("copy-done");
          } catch {
            copyButton.textContent = "Copy failed";
          }
          window.setTimeout(() => {
            copyButton.textContent = original;
            copyButton.classList.remove("copy-done");
          }, 1200);
        }

        const themeButton = event.target.closest("[data-theme-toggle]");
        if (themeButton) {
          const nextDark = !document.documentElement.classList.contains("dark");
          document.documentElement.classList.toggle("dark", nextDark);
          localStorage.setItem("theme", nextDark ? "dark" : "light");
        }
      });
    </script>
  </body>
</html>
